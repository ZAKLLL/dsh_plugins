{
  "name": "dsh-remote-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Manage coding agents that live on other machines: run a remote DSH web UI through an SSH port-forward and open it already authorized, or open a remote CLI agent (codex, …) in this window's terminal.",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
